{
 "teachings/1": {
  "id": 1,
  "title": "Bienvenue au Ministère ECEL",
  "title_en": "Welcome to Ministère ECEL",
  "author": "Ministère ECEL",
  "date": "2026-11-02",
  "body": "Ce premier enseignement est un exemple. L'administrateur peut le modifier ou le supprimer depuis l'espace Admin.",
  "body_en": "This first teaching is an example. The administrator can edit or delete it from the Admin area."
 },
 "prayers/e1623339577": {
  "kind": "evening",
  "item": {
   "t": "Père céleste, merci pour cette journée. Pardonne-moi mes fautes, garde ma famille et mon église cette nuit. Que ta paix repose sur nous. Au nom de Jésus, Amen.",
   "en": "Heavenly Father, thank you for this day. Forgive my sins, keep my family and my church tonight. May your peace rest upon us. In Jesus' name, Amen."
  }
 },
 "prayers/e1881183688": {
  "kind": "evening",
  "item": {
   "t": "Seigneur, je remets entre tes mains mes soucis et mes projets. Fortifie ma foi, guide mes pas demain. Amen.",
   "en": "Lord, I place my worries and my plans in your hands. Strengthen my faith and guide my steps tomorrow. Amen."
  }
 },
 "prayers/e-493004301": {
  "kind": "evening",
  "item": {
   "t": "Dieu de grâce, je te loue pour ta fidélité. Protège ma nation, bénis ton peuple et donne-nous un sommeil paisible. Amen.",
   "en": "God of grace, I praise you for your faithfulness. Protect my nation, bless your people and give us peaceful sleep. Amen."
  }
 },
 "prayers/m1451803886": {
  "kind": "morning",
  "item": {
   "t": "Père céleste, merci pour ce nouveau jour. Conduis mes pas, bénis mon travail et garde ma famille. Que ta volonté soit faite aujourd'hui. Amen.",
   "en": "Heavenly Father, thank you for this new day. Guide my steps, bless my work and keep my family. May your will be done today. Amen."
  }
 },
 "prayers/m595864032": {
  "kind": "morning",
  "item": {
   "t": "Seigneur, à toi je confie cette journée. Donne-moi la sagesse, la force et la paix pour tout ce que j'entreprendrai. Au nom de Jésus, Amen.",
   "en": "Lord, I entrust this day to you. Give me wisdom, strength and peace for all I do. In Jesus' name, Amen."
  }
 },
 "prayers/m1155108734": {
  "kind": "morning",
  "item": {
   "t": "Dieu fidèle, ta miséricorde se renouvelle chaque matin. Remplis-moi de ton Esprit et fais de moi une bénédiction autour de moi. Amen.",
   "en": "Faithful God, your mercies are new every morning. Fill me with your Spirit and make me a blessing to those around me. Amen."
  }
 },
 "prayers/o1": {
  "kind": "other",
  "item": {
   "id": 1,
   "title": "Prière de gratitude",
   "title_en": "Prayer of thanksgiving",
   "when": "Chaque jour",
   "when_en": "Every day",
   "body": "Seigneur, merci pour tout ce que tu fais dans ma vie. Je te rends grâce pour ta bonté et ta fidélité. Amen.",
   "body_en": "Lord, thank you for all you do in my life. I give you thanks for your goodness and your faithfulness. Amen.",
   "date": "2026-11-02"
  }
 },
 "prayers/o2": {
  "kind": "other",
  "item": {
   "id": 2,
   "title": "Prière d'intercession pour l'église",
   "title_en": "Intercession prayer for the church",
   "when": "Chaque semaine",
   "when_en": "Every week",
   "body": "Père, nous te prions pour le Ministère ECEL : donne la sagesse aux conducteurs, l'unité aux frères et sœurs, et la puissance de l'Évangile pour libérer les cœurs. Amen.",
   "body_en": "Father, we pray for Ministère ECEL: give wisdom to the leaders, unity to the brothers and sisters, and the power of the Gospel to set hearts free. Amen.",
   "date": "2026-11-02"
  }
 },
